# Local configuration and virtual environments
.env
.env.*
!.env.example
.venv/
.venv-*/
venv/
__pycache__/
*.py[cod]

# Application-owned state. The reviewed baseline lives under hermes/.
hermes-data/

# Model weights and generated inference artifacts, regardless of location
models/*
!models/.gitkeep
*.ninfer
*.gguf
*.safetensors
*.ckpt
*.pth
*.pt
*.onnx
*.bin

# Agent-created workspace content
workspace/*
!workspace/README.md

# Benchmark output can contain prompts and model responses
benchmarks/*
!benchmarks/README.md

# Local build, test, and runtime output
build/
out/
dist/
coverage/
*.log
*.jsonl
*.sqlite
*.sqlite3
*.db

# Private keys, certificates, and local SSH material
.ssh/
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.pem
*.key
*.p12
*.pfx

# Editors and operating systems
.DS_Store
Thumbs.db
.idea/
.vscode/
