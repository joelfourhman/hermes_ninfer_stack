# Local configuration and virtual environments
.env
.env.*
!.env.example
.venv/
.venv-*/
venv/
__pycache__/
*.py[cod]

# Legacy container-Hermes state from releases before the native Desktop switch.
# Keep it private if it still exists in an upgraded checkout.
hermes-data/

# Model weights and generated inference artifacts, regardless of location
models/*
!models/.gitkeep
# Legacy conversion cache from releases before direct artifact downloads.
model-build/
*.ninfer
*.gguf
*.safetensors
*.ckpt
*.pth
*.pt
*.onnx
*.bin

# Private projects retained from releases that used a repository workspace.
# Current setup does not create or configure this directory.
workspace/

# Benchmark output can contain prompts and model responses
benchmarks/*
!benchmarks/README.md

# Local build, test, and runtime output
build/
out/
dist/
coverage/
*.log
*.jsonl
*.sqlite
*.sqlite3
*.db
.ninfer-jobs/
PROJECT_STATE.json
PROJECT_STATE.json.*
PROJECT_STATE.lock
EPOCH_REPORT.json

# Private keys, certificates, and local SSH material
.ssh/
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.pem
*.key
*.p12
*.pfx

# Editors and operating systems
.DS_Store
Thumbs.db
