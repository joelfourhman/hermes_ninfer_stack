# Run `python stack.py setup` to create .env. Never commit the generated file.
# The digest pins the reviewed linux/amd64 image for Hermes Agent v0.20.5.
HERMES_IMAGE=nousresearch/hermes-agent:v2026.8.19@sha256:f3cba6abf5ed80d47a271498d663ace5dda87f45000552afb8be8370a35df1b5
HERMES_UID=1000
HERMES_GID=1000

# Generated by setup.sh. Empty values deliberately make Compose fail closed.
NINFER_API_KEY=
HERMES_API_SERVER_KEY=

# Authenticated Hermes web dashboard, published on host loopback only.
HERMES_DASHBOARD_ENABLED=true
HERMES_DASHBOARD_HOST_PORT=9119
HERMES_DASHBOARD_USERNAME=hermes
HERMES_DASHBOARD_PASSWORD=
HERMES_DASHBOARD_SECRET=

# Optional token for higher Hugging Face download limits. The tested model is public.
HF_TOKEN=

# NInfer is published on host loopback only.
NINFER_HOST_PORT=8080

# Inference settings shared by Compose, Hermes configuration, and validation.
NINFER_GPU_DEVICE=0
NINFER_MODEL_FILE=qwen3_8_27b_nvfp4.ninfer
NINFER_MODEL_ID=qwen-local
NINFER_CONTEXT_LENGTH=65536
NINFER_KV_CAPACITY=65536
NINFER_MAX_CONCURRENCY=1

# Hermes session controls matched to the interactive context profile.
HERMES_COMPRESSION_ENABLED=true
HERMES_MAX_TURNS=40

# Compose-enforced resource limits for the non-GPU services.
HERMES_CPUS=4.0
HERMES_MEMORY=8g
HERMES_PIDS=512
SANDBOX_CPUS=4.0
SANDBOX_MEMORY=8g
SANDBOX_PIDS=512
