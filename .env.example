# Run `python ninfer.py setup`; it creates .env automatically.
# Do not copy or edit this template for a normal first-time setup.

# Generated by setup. Empty values deliberately make Compose fail closed.
NINFER_API_KEY=

# Leave blank. The source model is public; a token is only useful if Hugging Face rate-limits you.
HF_TOKEN=

# Internal model-builder identity. Setup chooses host-specific values where needed.
MODEL_BUILD_UID=1000
MODEL_BUILD_GID=1000

# Safe single-RTX-5090 defaults. Fresh setup selects the detected 5090 GPU index.
# Leave these unchanged unless troubleshooting says otherwise.
# The API is authenticated and reachable only from this computer.
NINFER_HOST_PORT=8080

# Pinned inference settings shared by Compose and validation.
NINFER_GPU_DEVICE=0
NINFER_MODEL_FILE=qwen3_8_27b_uncensored.ninfer
NINFER_MODEL_ID=qwen-local
NINFER_CONTEXT_LENGTH=131072
NINFER_KV_CAPACITY=131072
NINFER_MAX_CONCURRENCY=1

# Applied only when the optional native Hermes Desktop helper is used.
HERMES_COMPRESSION_ENABLED=true
HERMES_COMPRESSION_THRESHOLD_TOKENS=100000
HERMES_MAX_TURNS=40
