# Run `python ninfer.py setup`; it creates .env automatically.
# Do not copy or edit this template for a normal first-time setup.

# Generated by setup. Empty values deliberately make Compose fail closed.
NINFER_API_KEY=

# Leave blank. Both model artifacts are public; a token is only useful if Hugging Face rate-limits you.
HF_TOKEN=

# Internal model-downloader identity. Setup chooses host-specific values where needed.
MODEL_DOWNLOAD_UID=1000
MODEL_DOWNLOAD_GID=1000

# Balanced single-RTX-5090 defaults. Fresh setup selects the detected 5090 GPU index.
# Leave these unchanged unless troubleshooting says otherwise.
# Local-only is the secure default. Use `python ninfer.py network --mode lan`
# instead of editing these values when a trusted LAN client needs access.
NINFER_ACCESS_MODE=local
NINFER_BIND_ADDRESS=127.0.0.1
NINFER_HOST_PORT=8080

# Pinned inference settings shared by Compose and validation.
NINFER_GPU_DEVICE=0
NINFER_MODEL_PROFILE=stock
NINFER_MODEL_FILE=qwen3_8_27b_nvfp4.ninfer
NINFER_MODEL_ID=qwen-local
NINFER_RUNTIME_PROFILE=balanced
NINFER_CONTEXT_LENGTH=131072
NINFER_KV_CAPACITY=196608
NINFER_MAX_CONCURRENCY=2
NINFER_PENDING_TIMEOUT_MS=120000
NINFER_KV_DTYPE=fp8
NINFER_DEVICE_STATE_SLOTS=2
NINFER_HOST_STATE_SLOTS=8
NINFER_HOST_KV_MIB=8192
NINFER_PRESERVE_THINKING=true
NINFER_SPEC_BACKEND=mtp
NINFER_DRAFT_TOKENS=3

# Applied only when the optional native Hermes Desktop helper is used.
HERMES_COMPRESSION_ENABLED=true
HERMES_COMPRESSION_THRESHOLD_TOKENS=90000
HERMES_MAX_TURNS=40

# Generated from stack/manifest.json.
NINFER_SOURCE_REVISION=d49296868dcc17bd478ec185f0d3a801bcc0bf56
